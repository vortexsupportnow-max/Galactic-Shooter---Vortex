# ── Supabase ────────────────────────────────────────────────
# Project URL (no trailing slash, no /rest/v1/)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key (found in Supabase → Settings → API)
SUPABASE_ANON_KEY=your-anon-key-here

# ── JWT (custom auth) ────────────────────────────────────────
# Secret used to sign/verify your own user tokens.
# Use the JWT Secret from Supabase → Settings → API → JWT Settings
JWT_SECRET=your-jwt-secret-here

# ── Server ───────────────────────────────────────────────────
PORT=3000
