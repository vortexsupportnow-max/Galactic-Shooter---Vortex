# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# Preferred: server-only key that bypasses RLS, so every table can be locked down
# with db/schema_rls.sql. Keep it out of the browser, logs and screenshots.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback for existing deployments. An anon key is PUBLIC by design and is only
# safe while the tables carry the permissive policies from db/schema.sql.
SUPABASE_ANON_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required in production (a missing or published secret stops the server).
# 32+ random characters recommended; shorter boots with a warning. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating it invalidates every issued token (all users must log in again).
JWT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated extra origins allowed to call the API from a browser.
# Leave empty for same-origin only (the default, and all this app needs).
ALLOWED_ORIGINS=
